<?xml version="1.0" encoding="utf-8"?>
<ExtensionManifest
    ExtensionBundleId="com.o3x.curve-truevalue"
    ExtensionBundleVersion="0.6.1"
    ExtensionBundleName="Curve-TrueValue"
    Version="9.0">

  <ExtensionList>
    <Extension Id="com.o3x.curve-truevalue.panel" Version="0.6.1"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects CC 2019 (16.0) 以降 -->
      <Host Name="AEFT" Version="[16.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.o3x.curve-truevalue.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- DevTools を有効化（PlayerDebugMode=1 の場合のみ動作） -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Curve-TrueValue</Menu>
          <Geometry>
            <Size>
              <Height>420</Height>
              <Width>280</Width>
            </Size>
            <MinSize>
              <Height>360</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
          <Icons/>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
